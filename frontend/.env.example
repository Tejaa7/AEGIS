# Public frontend config only. Never put secrets, API keys, JWT secrets,
# database passwords, or cloud credentials in this file or any frontend env var.
# Anything prefixed with VITE_ is exposed to the browser.

VITE_API_BASE_URL=http://localhost:5000

# Set to "true" only for local development when the backend is not available.
# Mock results must never be presented as real AI predictions.
VITE_USE_MOCK_API=false
